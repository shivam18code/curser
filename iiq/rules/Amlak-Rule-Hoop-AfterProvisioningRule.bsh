// Source mirror of Amlak-Rule-Hoop-AfterProvisioningRule.xml
// Import the .xml into IIQ, not this .bsh file.
//
// Purpose:
// 1) Keep existing failure-notification hooks (non-blocking).
// 2) After successful Create / Modify / Enable / Disable, refresh the IIQ Link:
//    a) Preferred: connector.getObject (requires Get Object URL = $getObject.nativeIdentity$)
//    b) Fallback: merge groups from the Modify plan AttributeRequests onto the Link
//       (so UI updates even if Get Object is still misconfigured)

import org.apache.log4j.Logger;
import sailpoint.object.Application;
import sailpoint.object.Filter;
import sailpoint.object.Link;
import sailpoint.object.ProvisioningPlan;
import sailpoint.object.ProvisioningPlan.AccountRequest;
import sailpoint.object.ProvisioningPlan.AttributeRequest;
import sailpoint.object.ProvisioningPlan.Operation;
import sailpoint.object.ProvisioningResult;
import sailpoint.object.QueryOptions;
import sailpoint.object.ResourceObject;
import sailpoint.object.Attributes;
import sailpoint.connector.Connector;
import sailpoint.connector.ConnectorFactory;
import java.util.ArrayList;
import java.util.Collection;
import java.util.Iterator;
import java.util.LinkedHashSet;
import java.util.List;

Logger log = Logger.getLogger("com.amlak.application.hoop");
String RULE_NAME = "Amlak-Rule-Hoop-AfterProvisioningRule";
log.info("Entering [" + RULE_NAME + "]");

if (plan == null) {
    log.warn("[" + RULE_NAME + "] ProvisioningPlan is NULL, skipping rule.");
    return null;
}

// --- Notifications (wrapped so a failure here never blocks Link refresh) ---
try {
    processProvisioningFailureNotification(plan);
} catch (Exception e) {
    log.error("[" + RULE_NAME + "] processProvisioningFailureNotification failed: " + e.getMessage(), e);
}

try {
    sendProvisioningFailureNotification(plan);
} catch (Exception e) {
    log.error("[" + RULE_NAME + "] sendProvisioningFailureNotification failed: " + e.getMessage(), e);
}

// Helper: flatten AttributeRequest value to a list of strings
List toValueList(Object val) {
    List out = new ArrayList();
    if (val == null) {
        return out;
    }
    if (val instanceof Collection) {
        Iterator vi = ((Collection) val).iterator();
        while (vi.hasNext()) {
            Object one = vi.next();
            if (one != null && String.valueOf(one).trim().length() > 0) {
                out.add(String.valueOf(one).trim());
            }
        }
    } else {
        String s = String.valueOf(val).trim();
        if (s.length() > 0) {
            out.add(s);
        }
    }
    return out;
}

// Helper: current Link.groups into a set
LinkedHashSet linkGroupsToSet(Link link) {
    LinkedHashSet set = new LinkedHashSet();
    Object current = link.getAttribute("groups");
    if (current instanceof Collection) {
        Iterator ci = ((Collection) current).iterator();
        while (ci.hasNext()) {
            Object one = ci.next();
            if (one != null && String.valueOf(one).trim().length() > 0) {
                set.add(String.valueOf(one).trim());
            }
        }
    } else if (current != null && String.valueOf(current).trim().length() > 0) {
        set.add(String.valueOf(current).trim());
    }
    return set;
}

// --- Refresh Link from target after successful provisioning ---
try {
    String appName = (application != null) ? application.getName() : "Hoop";
    List acctReqs = plan.getAccountRequests();

    if (acctReqs == null || acctReqs.isEmpty()) {
        log.debug("[" + RULE_NAME + "] No AccountRequests on plan, nothing to do.");
    } else {
        Connector connector = null;
        try {
            connector = ConnectorFactory.getConnector(application, null);
        } catch (Exception connEx) {
            log.error("[" + RULE_NAME + "] Could not get connector: " + connEx.getMessage(), connEx);
        }

        for (Iterator it = acctReqs.iterator(); it.hasNext();) {
            AccountRequest acctReq = (AccountRequest) it.next();

            String reqApp = acctReq.getApplication();
            if (appName != null && reqApp != null && !appName.equals(reqApp)) {
                continue;
            }

            AccountRequest.Operation op = acctReq.getOperation();
            if (op == null) {
                continue;
            }
            String opStr = op.toString();
            String nativeIdentity = acctReq.getNativeIdentity();
            log.info("[" + RULE_NAME + "] AccountRequest op=" + opStr + " nativeIdentity=" + nativeIdentity);

            boolean shouldRefresh =
                "Create".equals(opStr)
                || "Modify".equals(opStr)
                || "Enable".equals(opStr)
                || "Disable".equals(opStr);

            if (!shouldRefresh) {
                continue;
            }

            ProvisioningResult acctResult = acctReq.getResult();
            if (acctResult == null) {
                acctResult = result;
            }

            boolean success = true;
            if (acctResult != null && acctResult.getStatus() != null) {
                success = ProvisioningResult.STATUS_COMMITTED.equals(acctResult.getStatus());
            } else {
                log.warn("[" + RULE_NAME + "] No ProvisioningResult for " + nativeIdentity
                    + ", proceeding without status confirmation.");
            }

            if (!success) {
                log.warn("[" + RULE_NAME + "] " + opStr + " did not commit for " + nativeIdentity
                    + " (status=" + (acctResult != null ? acctResult.getStatus() : "null")
                    + "), skipping Link refresh.");
                continue;
            }

            if (nativeIdentity == null || nativeIdentity.trim().length() == 0) {
                log.warn("[" + RULE_NAME + "] nativeIdentity empty, skip refresh.");
                continue;
            }

            QueryOptions qo = new QueryOptions();
            qo.addFilter(Filter.eq("application.name", appName));
            qo.addFilter(Filter.eq("nativeIdentity", nativeIdentity));

            List links = context.getObjects(Link.class, qo);
            if (links == null || links.isEmpty()) {
                log.warn("[" + RULE_NAME + "] No Link found for nativeIdentity=" + nativeIdentity);
                continue;
            }

            Link link = (Link) links.get(0);
            boolean refreshed = false;

            // Preferred: Single Account Aggregation equivalent (Get Object)
            // REQUIRES Get Object contextUrl = /api/users/$getObject.nativeIdentity$
            if (connector != null) {
                try {
                    ResourceObject ro = connector.getObject(Connector.TYPE_ACCOUNT, nativeIdentity, null);
                    if (ro != null && ro.getAttributes() != null) {
                        Attributes attrs = ro.getAttributes();

                        if (attrs.containsKey("groups")) {
                            link.setAttribute("groups", attrs.get("groups"));
                        }
                        if (attrs.containsKey("status")) {
                            link.setAttribute("status", attrs.get("status"));
                        }
                        if (attrs.containsKey("name")) {
                            link.setAttribute("name", attrs.get("name"));
                        }
                        if (attrs.containsKey("email")) {
                            link.setAttribute("email", attrs.get("email"));
                        }
                        if (attrs.containsKey("role")) {
                            link.setAttribute("role", attrs.get("role"));
                        }
                        if (attrs.containsKey("id")) {
                            link.setAttribute("id", attrs.get("id"));
                        }

                        context.saveObject(link);
                        context.commitTransaction();
                        refreshed = true;
                        log.info("[" + RULE_NAME + "] Refreshed Link from getObject for "
                            + nativeIdentity + " op=" + opStr
                            + " groups=" + link.getAttribute("groups")
                            + " status=" + link.getAttribute("status"));
                    } else {
                        log.warn("[" + RULE_NAME + "] getObject returned null/empty for " + nativeIdentity
                            + " — check Get Object URL uses $getObject.nativeIdentity$");
                    }
                } catch (Exception getEx) {
                    log.error("[" + RULE_NAME + "] getObject refresh failed for " + nativeIdentity
                        + ": " + getEx.getMessage()
                        + " — ensure Get Object URL is /api/users/$getObject.nativeIdentity$", getEx);
                }
            }

            // Fallback A: Modify — apply groups Add/Remove from the plan onto the Link
            if (!refreshed && "Modify".equals(opStr)) {
                try {
                    LinkedHashSet merged = linkGroupsToSet(link);
                    List groupReqs = acctReq.getAttributeRequests("groups");
                    boolean touched = false;

                    if (groupReqs != null) {
                        for (Iterator gri = groupReqs.iterator(); gri.hasNext();) {
                            AttributeRequest gar = (AttributeRequest) gri.next();
                            if (gar == null) {
                                continue;
                            }
                            Operation aop = gar.getOperation();
                            String aopStr = (aop != null) ? aop.toString() : "";
                            List vals = toValueList(gar.getValue());
                            log.info("[" + RULE_NAME + "] Plan groups AttributeRequest op=" + aopStr
                                + " values=" + vals);

                            if ("Add".equals(aopStr)) {
                                merged.addAll(vals);
                                touched = true;
                            } else if ("Remove".equals(aopStr)) {
                                merged.removeAll(vals);
                                touched = true;
                            } else if ("Set".equals(aopStr)) {
                                merged.clear();
                                merged.addAll(vals);
                                touched = true;
                            }
                        }
                    }

                    if (touched) {
                        link.setAttribute("groups", new ArrayList(merged));
                        context.saveObject(link);
                        context.commitTransaction();
                        refreshed = true;
                        log.info("[" + RULE_NAME + "] Fallback refreshed Link groups from plan for "
                            + nativeIdentity + " groups=" + link.getAttribute("groups"));
                    } else {
                        log.warn("[" + RULE_NAME + "] Modify had no usable groups AttributeRequests for "
                            + nativeIdentity);
                    }
                } catch (Exception planEx) {
                    log.error("[" + RULE_NAME + "] Plan-based groups fallback failed: "
                        + planEx.getMessage(), planEx);
                }
            }

            // Fallback B: Enable/Disable — patch status
            if (!refreshed && ("Enable".equals(opStr) || "Disable".equals(opStr))) {
                String newStatus = "Enable".equals(opStr) ? "active" : "inactive";
                link.setAttribute("status", newStatus);
                context.saveObject(link);
                context.commitTransaction();
                refreshed = true;
                log.info("[" + RULE_NAME + "] Fallback set status=" + newStatus + " for " + nativeIdentity);
            }

            if (!refreshed) {
                log.warn("[" + RULE_NAME + "] Link groups/status NOT refreshed for " + nativeIdentity
                    + ". Fix Get Object to $getObject.nativeIdentity$ and re-import this rule.");
            }
        }
    }
} catch (Exception e) {
    log.error("[" + RULE_NAME + "] Link refresh block failed: " + e.getMessage(), e);
}

log.info("Exiting [" + RULE_NAME + "]");
return null;
