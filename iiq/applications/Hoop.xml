        </Map>
      </Attributes>
      <Section name="Section 1">
        <Field displayName="name" name="name" type="string">
          <Script>
            <Source>String first = identity.getFirstname();
String last = identity.getLastname();

if (first == null) first = "";
if (last == null) last = "";

return (first + " " + last).trim();</Source>
          </Script>
        </Field>
        <Field displayName="email" name="email" type="string">
          <Script>
            <Source>return identity.getEmail();</Source>
          </Script>
        </Field>
      </Section>
    </Form>
